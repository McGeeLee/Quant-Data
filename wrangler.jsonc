{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quant-data",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/healthz",
      "/openapi.json",
      "/mcp",
      "/llms.txt",
      "/llms-full.txt"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 0.1
    }
  },
  "ratelimits": [
    {
      "name": "MARKET_RATE_LIMIT",
      "namespace_id": "1222215593",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "version_metadata": {
    "binding": "VERSION_METADATA"
  },
  "vars": {
    "APP_VERSION": "3.0.0"
  },
  "secrets": {
    "required": ["TUSHARE_TOKEN", "TIINGO_KEY"]
  }
}
